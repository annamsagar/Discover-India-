DATABASE_URL=jdbc:postgresql://localhost:5432/discoverindia
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_256_bits_long
JWT_EXPIRATION_MS=86400000

# Provide ONE of the following AI API Keys depending on the# AI Configuration (For Chatbot & Trip Planner)
# provider can be 'gemini' or 'groq'
AI_PROVIDER=groq
AI_API_KEY=your_groq_or_gemini_api_key_here # e.g., gemini, openai, anthropic

# Maps API (Google Maps preferred)
MAPS_API_KEY=your_google_maps_api_key_here

# Weather API (Optional)
WEATHER_API_KEY=your_weather_api_key_here
